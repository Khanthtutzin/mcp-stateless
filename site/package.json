{
  "name": "@mcp-stateless/site",
  "private": true,
  "type": "module",
  "description": "Documentation site for mcp-stateless. Deliberately not a workspace of the root package, which must keep zero runtime dependencies.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css}\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.18.0"
  }
}
